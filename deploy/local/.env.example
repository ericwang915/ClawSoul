# ClawSoul — single-tenant self-hosted configuration
# Copy to .env, fill in the required keys, then: docker compose up
# Anything left unset degrades gracefully (that feature just turns off).

# ── Required: one text-LLM key ────────────────────────────────────────
# Set the key for ONE provider — it's auto-detected, no need to also set
# CLAW_LLM_PROVIDER. Uncomment whichever you have.
#
# OpenRouter — one key, hundreds of models, easiest to start  https://openrouter.ai
CLAW_OPENROUTER_API_KEY=sk-or-your-key-here
# CLAW_OPENAI_API_KEY=sk-...                     https://platform.openai.com
# CLAW_DEEPSEEK_API_KEY=sk-...                   https://platform.deepseek.com
# CLAW_CLAUDE_API_KEY=sk-ant-...                 https://console.anthropic.com
# CLAW_GEMINI_API_KEY=...                        https://aistudio.google.com
# CLAW_GROK_API_KEY=xai-...                      https://console.x.ai
# CLAW_QWEN_API_KEY=sk-...                       https://dashscope.aliyun.com
# CLAW_GROQ_API_KEY=gsk_...                      https://console.groq.com
# CLAW_MISTRAL_API_KEY=...                       https://console.mistral.ai
# CLAW_TOGETHER_API_KEY=...                      https://api.together.ai
# CLAW_SILICONFLOW_API_KEY=sk-...                https://siliconflow.cn
# CLAW_KIMI_API_KEY=sk-...  ·  CLAW_GLM_API_KEY=...
#
# Fully local, no key, nothing leaves your machine (run Ollama on the host):
# CLAW_LLM_PROVIDER=ollama
# CLAW_OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# CLAW_OLLAMA_MODEL=llama3.1
#
# Override the model for any provider: CLAW_<PROVIDER>_MODEL=...

# Your Telegram bot, created via @BotFather (/newbot → copy the token).
CLAW_TELEGRAM_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# Your own numeric Telegram user id (ask @userinfobot). Keeps strangers out
# of your bot — and out of your API budget.
CLAW_TELEGRAM_ALLOWED_USERS=12345678

# ── Optional — photos ─────────────────────────────────────────────────
# Seedream (BytePlus ModelArk) — selfies / candid shots. ~$0.035 per image.
#   https://www.byteplus.com/en/product/modelark
# CLAW_SEEDREAM_API_KEY=
# Gemini — lets her SEE the photos you send (vision input).
# CLAW_GEMINI_API_KEY=

# ── Optional — voice & search ─────────────────────────────────────────
# Deepgram — she understands your Telegram voice notes. https://deepgram.com
# CLAW_DEEPGRAM_API_KEY=
# Tavily — live web search grounding. https://tavily.com
# CLAW_TAVILY_API_KEY=

# ── Optional — web dashboard auth ────────────────────────────────────
# Leave all of these UNSET for a single-user self-host: the dashboard
# opens with no login (that's the intended standalone mode). Only set
# these if you're running a multi-user deployment behind Supabase auth.
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_JWT_SECRET=your-jwt-secret
# ALLOWED_EMAILS=you@example.com
# Force open access even if a Supabase var happens to be present:
# CLAW_DEV_NO_AUTH=1

# ── Paths / ports ─────────────────────────────────────────────────────
CLAWSOUL_HOME=/data
PORT=7788
