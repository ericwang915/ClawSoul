# ClawSoul — single-tenant self-hosted configuration
# Copy to .env, fill in the required keys, then: docker compose up
# Anything left unset degrades gracefully (that feature just turns off).

# ── Required: one text-LLM key ────────────────────────────────────────
# Set the key for ONE provider — it's auto-detected, no need to also set
# CLAW_LLM_PROVIDER. Uncomment whichever you have.
#
# OpenRouter — one key, hundreds of models, easiest to start  https://openrouter.ai
CLAW_OPENROUTER_API_KEY=sk-or-your-key-here
# CLAW_OPENAI_API_KEY=sk-...                     https://platform.openai.com
# CLAW_DEEPSEEK_API_KEY=sk-...                   https://platform.deepseek.com
# CLAW_CLAUDE_API_KEY=sk-ant-...                 https://console.anthropic.com
# CLAW_GEMINI_API_KEY=...                        https://aistudio.google.com
# CLAW_GROK_API_KEY=xai-...                      https://console.x.ai
# CLAW_QWEN_API_KEY=sk-...                       https://dashscope.aliyun.com
# CLAW_GROQ_API_KEY=gsk_...                      https://console.groq.com
# CLAW_MISTRAL_API_KEY=...                       https://console.mistral.ai
# CLAW_TOGETHER_API_KEY=...                      https://api.together.ai
# CLAW_SILICONFLOW_API_KEY=sk-...                https://siliconflow.cn
# CLAW_KIMI_API_KEY=sk-...  ·  CLAW_GLM_API_KEY=...
#
# Fully local, no key, nothing leaves your machine (run Ollama on the host):
# CLAW_LLM_PROVIDER=ollama
# CLAW_OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# CLAW_OLLAMA_MODEL=llama3.1
#
# Override the model for any provider: CLAW_<PROVIDER>_MODEL=...

# Your Telegram bot, created via @BotFather (/newbot → copy the token).
CLAW_TELEGRAM_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# Your own numeric Telegram user id (ask @userinfobot). Keeps strangers out
# of your bot — and out of your API budget.
CLAW_TELEGRAM_ALLOWED_USERS=12345678

# ── Optional — photos ─────────────────────────────────────────────────
# Selfies and candid shots. Set ONE of these — the backend is auto-detected,
# same as the LLM. Skip them all and everything else still works.
#
# Zero signup:
#   Nothing to set. Uses a free public service (your prompts go to it).
# CLAW_IMAGE_PROVIDER=pollinations
#
# Keys you may already have — no second signup:
#   Gemini: the key below also gives her vision, so one key does both.
# CLAW_IMAGE_GEMINI_KEY=                         https://aistudio.google.com
#   OpenRouter: the same key from the quickstart also generates images.
# CLAW_IMAGE_OPENROUTER_KEY=                     https://openrouter.ai/keys
#   Qwen / Wan, via DashScope — reuses an Alibaba account.
# CLAW_DASHSCOPE_API_KEY=          https://dashscope.console.aliyun.com
#
# Best face consistency (she stays recognisably the same person):
#   Black Forest Labs — FLUX.1 Kontext preserves a reference subject.
# CLAW_BFL_API_KEY=                                     https://api.bfl.ai
#   Seedream (BytePlus ModelArk) — ~$0.035/image.
# CLAW_SEEDREAM_API_KEY=      https://www.byteplus.com/en/product/modelark
#   OpenAI gpt-image-1.
# CLAW_IMAGE_OPENAI_KEY=                       https://platform.openai.com
#
# Other hosted:
# CLAW_FAL_KEY=                                            https://fal.ai
# CLAW_REPLICATE_API_TOKEN=                          https://replicate.com
# CLAW_STABILITY_API_KEY=                       https://platform.stability.ai
#
# Fully local — no key, no upload, nothing about her appearance leaves
# your machine. Point at whichever you already run:
# CLAW_COMFYUI_BASE_URL=http://localhost:8188
# CLAW_SDWEBUI_BASE_URL=http://localhost:7860
#
# Anything else speaking the OpenAI image API (Together, DeepInfra, Novita,
# SiliconFlow, Fireworks…):
# CLAW_IMAGE_PROVIDER=custom
# CLAW_IMAGE_API_KEY=
# CLAW_CUSTOM_BASE_URL=
#
# Pin a specific model on whichever backend you chose:
# CLAW_IMAGE_MODEL=

# Gemini — lets her SEE the photos you send (vision input).
# CLAW_GEMINI_API_KEY=

# ── Optional — voice & search ─────────────────────────────────────────
# Deepgram — she understands your Telegram voice notes. https://deepgram.com
# CLAW_DEEPGRAM_API_KEY=
# Tavily — live web search grounding. https://tavily.com
# CLAW_TAVILY_API_KEY=

# ── Optional — dashboard access ──────────────────────────────────────
# The dashboard has no login: it assumes it's yours, on your machine.
# Do NOT expose port 7788 to the public internet — put it behind a VPN,
# an SSH tunnel, or a reverse proxy that does the authenticating.
#
# Only needed if you serve the dashboard from a different origin:
# CLAW_ALLOWED_ORIGINS=https://dash.example.com

# ── Optional — self-imposed limits ───────────────────────────────────
# All off by default: it's your machine and your API bill. Set these only
# if you want a guard rail (a small VPS, or a bot several people use).
# Configure under "quota" in claw_soul.json:
#   diskMb         cap the data directory   (0 = unlimited)
#   dailyMessages  cap chat turns per day   (0 = unlimited)
#   dailyPhotos    cap generated photos/day (0 = unlimited)

# ── Paths / ports ─────────────────────────────────────────────────────
CLAWSOUL_HOME=/data
PORT=7788
