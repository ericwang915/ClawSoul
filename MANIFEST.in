include LICENSE README.md README.zh-CN.md SAFETY.md SECURITY.md
# *.md and *.jpg matter at runtime: the bundled personas, souls and skills are
# Markdown, and the dashboard ships a default hero image. Omitting them built
# an sdist that installed a companion with no personality.
recursive-include claw_soul *.py *.md *.html *.css *.js *.png *.jpg *.ico *.yaml *.yml *.sh
recursive-include tests *.py

exclude claw_soul.json
exclude claw_soul.example.json
exclude .env .env.example
recursive-exclude * __pycache__
recursive-exclude * *.py[cod]
recursive-exclude * *.pyc
recursive-exclude context *
recursive-exclude .github *
recursive-exclude assets *
