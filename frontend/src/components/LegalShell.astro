---
import Layout from '../layouts/Layout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';

interface Props {
  title: string;
  subtitle?: string;
  updated?: string;
  metaTitle?: string;
  metaDescription?: string;
}

const { title, subtitle, updated, metaTitle, metaDescription } = Astro.props;
---

<Layout title={metaTitle ?? `${title} · her & him`} description={metaDescription}>
  <Nav />
  <main class="legal">
    <div class="container legal__inner">
      <span class="orb legal__orb"></span>
      <h1>{title}</h1>
      {subtitle && <p class="legal__sub">{subtitle}</p>}
      {updated && <p class="legal__updated">Last updated · {updated}</p>}
      <div class="prose">
        <slot />
      </div>

      <div class="legal__nav">
        <a href="/terms">Terms</a>
        <a href="/privacy">Privacy</a>
        <a href="/safety">Safety</a>
        <a href="/support">Support</a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .legal { padding: 64px 0 96px; }
  .legal__inner { max-width: 760px; }
  .legal__orb { display: block; width: 54px; height: 54px; margin-bottom: 28px; }
  .legal h1 { margin-bottom: 0.3em; }
  .legal__sub { font-size: 1.1rem; color: var(--text); max-width: 620px; margin-bottom: 0.5em; }
  .legal__updated { font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0; }

  .prose { margin-top: 44px; }
  .prose :global(h2) {
    font-size: 1.45rem; color: #fff; margin: 48px 0 14px;
    padding-top: 28px; border-top: 1px solid var(--border);
  }
  .prose :global(h2:first-of-type) { border-top: 0; padding-top: 0; margin-top: 0; }
  .prose :global(h3) { font-size: 1.08rem; color: var(--text); margin: 26px 0 10px; }
  .prose :global(p) { color: var(--text-soft); margin: 0 0 16px; line-height: 1.7; }
  .prose :global(strong) { color: var(--text); font-weight: 600; }
  .prose :global(a) { color: var(--accent); }
  .prose :global(ul) { margin: 0 0 18px; padding-left: 22px; color: var(--text-soft); }
  .prose :global(li) { margin: 0 0 9px; line-height: 1.65; }
  .prose :global(.callout) {
    background: var(--gradient-soft); border: 1px solid var(--border-strong);
    border-radius: var(--radius); padding: 22px 24px; margin: 0 0 22px;
  }
  .prose :global(.callout p) { margin: 0; color: var(--text); }
  .prose :global(.callout p + p) { margin-top: 10px; }
  .prose :global(.muted) { font-size: 0.9rem; color: var(--text-muted); }

  .legal__nav {
    display: flex; gap: 22px; flex-wrap: wrap; margin-top: 64px;
    padding-top: 26px; border-top: 1px solid var(--border);
    font-size: 0.92rem; color: var(--text-soft);
  }
  .legal__nav a:hover { color: var(--accent); opacity: 1; }
</style>
