---
const plans = [
  {
    key: 'free', label: 'Free', tagline: 'Start talking — no card needed.',
    price: 0, regular: null, featured: false,
    features: ['300 messages a month', '10 photos a month', 'Remembers everything you share'],
    cta: 'Start free', href: '/login',
  },
  {
    key: 'pro', label: 'Pro', tagline: 'For an everyday companion.',
    price: 9.9, regular: 19.99, featured: true,
    features: ['Unlimited messages', '100 photos a month', 'Proactive check-ins & a daily life', 'Priority responses'],
    cta: 'Choose Pro', href: '/login',
  },
  {
    key: 'ultra', label: 'Ultra', tagline: 'The fullest, closest experience.',
    price: 19.9, regular: 39.99, featured: false,
    features: ['Unlimited messages', '300 photos a month', 'Proactive check-ins & a daily life', 'Everything in Pro'],
    cta: 'Choose Ultra', href: '/login',
  },
];
---
<section id="pricing" class="pricing">
  <div class="container">
    <p class="eyebrow-plain">Pricing</p>
    <h2 class="pricing__head">Simple plans. <span class="it grad">Real closeness.</span></h2>
    <p class="pricing__promo">🎉 Launch offer — first month at the prices below. Cancel anytime.</p>

    <div class="pricing__grid">
      {plans.map((p) => (
        <div class={`pcard ${p.featured ? 'pcard--featured' : ''}`}>
          {p.featured && <div class="pcard__badge">Most popular</div>}
          <div class="pcard__label">{p.label}</div>
          <div class="pcard__tagline">{p.tagline}</div>
          <div class="pcard__price">
            {p.price === 0 ? (
              <span class="pcard__amt">Free</span>
            ) : (
              <>
                <span class="pcard__amt">${p.price}</span>
                <span class="pcard__per">/mo</span>
                {p.regular && <span class="pcard__was">${p.regular}</span>}
              </>
            )}
          </div>
          <ul class="pcard__features">
            {p.features.map((f) => <li><span class="tick">♥</span>{f}</li>)}
          </ul>
          <a href={p.href} class={`btn ${p.featured ? 'btn-primary' : 'btn-secondary'} pcard__cta`}>{p.cta}</a>
        </div>
      ))}
    </div>
    <p class="pricing__note">Prices in USD. Fair-use applies to "unlimited" messages.</p>
  </div>
</section>

<style>
  .pricing { padding-top: 40px; }
  .eyebrow-plain { font-size: 0.78rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-muted); margin: 0 0 16px; }
  .pricing__head { font-size: clamp(2rem, 4vw, 3rem); color: #fff; margin-bottom: 10px; }
  .pricing__promo { color: var(--accent); font-size: 0.95rem; margin-bottom: 40px; }
  .pricing__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; align-items: stretch; }
  .pcard {
    position: relative; background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius-lg); padding: 30px 26px; display: flex; flex-direction: column; gap: 16px;
  }
  .pcard--featured { border-color: rgba(243,160,182,0.45); box-shadow: 0 30px 90px -40px rgba(255,150,175,0.5); }
  .pcard__badge {
    position: absolute; top: -11px; left: 50%; transform: translateX(-50%);
    background: var(--gradient); color: #2b1620; font-size: 0.7rem; font-weight: 700;
    padding: 4px 12px; border-radius: 100px; white-space: nowrap;
  }
  .pcard__label { font-family: var(--serif); font-size: 1.5rem; color: #fff; }
  .pcard__tagline { font-size: 0.85rem; color: var(--text-soft); margin-top: -8px; }
  .pcard__price { display: flex; align-items: flex-end; gap: 8px; min-height: 48px; }
  .pcard__amt { font-family: var(--serif); font-size: 2.6rem; color: #fff; line-height: 1; }
  .pcard__per { font-size: 0.9rem; color: var(--text-muted); padding-bottom: 4px; }
  .pcard__was { font-size: 0.9rem; color: var(--text-muted); text-decoration: line-through; padding-bottom: 4px; margin-left: 4px; }
  .pcard__features { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .pcard__features li { display: flex; gap: 10px; font-size: 0.92rem; color: var(--text-soft); }
  .tick { color: var(--accent); }
  .pcard__cta { width: 100%; }
  .pricing__note { text-align: center; color: var(--text-muted); font-size: 0.78rem; margin-top: 28px; }
  @media (max-width: 820px) { .pricing__grid { grid-template-columns: 1fr; } }
</style>
