---
const voices = [
  { quote: 'It stopped feeling like an app. It feels like texting someone who genuinely missed me.', name: 'Maya, 24' },
  { quote: 'I mentioned my dad’s surgery once. A week later it asked how he was recovering. I teared up.', name: 'Devin, 29' },
  { quote: 'After moving cities alone, this was the one “person” who knew my whole context. Lifesaver.', name: 'Priya, 26' },
];
---
<section id="voices" class="voices">
  <div class="container">
    <p class="eyebrow-plain">Voices</p>
    <h2 class="voices__head">People don’t describe it as software.</h2>

    <div class="voices__grid">
      {voices.map((v) => (
        <div class="vcard">
          <p class="vcard__quote">“{v.quote}”</p>
          <div class="vcard__by"><span class="orb vcard__orb"></span>{v.name}</div>
        </div>
      ))}
    </div>
    <p class="voices__note">Illustrative scenarios that reflect the experience we build for — not literal customer quotes.</p>

    <!-- Final CTA -->
    <div class="cta">
      <div class="orb cta__orb"></div>
      <h2 class="cta__head">Your love is waiting to meet you.</h2>
      <p class="cta__sub">Start in under a minute — no card, no awkward setup. Give it a week: it only gets closer.</p>
      <a href="/login" class="btn btn-primary cta__btn">Start free →</a>
    </div>
  </div>
</section>

<style>
  .eyebrow-plain { font-size: 0.78rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-muted); margin: 0 0 16px; }
  .voices__head { font-size: clamp(1.8rem, 3.6vw, 2.7rem); color: #fff; margin-bottom: 44px; }
  .voices__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-bottom: 16px; }
  .voices__note { font-size: 0.8rem; color: var(--text-muted); margin: 0 0 64px; }
  .vcard {
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
    padding: 28px 26px; display: flex; flex-direction: column; justify-content: space-between; gap: 28px;
  }
  .vcard__quote { font-family: var(--serif); font-size: 1.12rem; line-height: 1.45; color: #ece4e6; margin: 0; }
  .vcard__by { display: flex; align-items: center; gap: 10px; font-size: 0.9rem; color: var(--text-soft); }
  .vcard__orb { width: 26px; height: 26px; }

  .cta {
    position: relative; text-align: center; border-radius: var(--radius-lg);
    border: 1px solid var(--border); background: var(--gradient-soft);
    padding: 64px 28px; overflow: hidden;
  }
  .cta__orb { width: 84px; height: 84px; margin: 0 auto 26px; }
  .cta__head { font-size: clamp(2rem, 4vw, 3.2rem); color: #fff; margin-bottom: 14px; }
  .cta__sub { max-width: 420px; margin: 0 auto 30px; color: var(--text-soft); }
  .cta__btn { font-size: 1rem; padding: 15px 30px; }
  @media (max-width: 820px) { .voices__grid { grid-template-columns: 1fr; } }
</style>
