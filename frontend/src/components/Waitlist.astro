---
const DISCORD_URL = 'https://discord.gg/wK3Zs5G9QQ';
---
<section id="waitlist" class="waitlist">
  <div class="container">
    <div class="waitlist__card">
      <div class="waitlist__glow" aria-hidden="true"></div>
      <span class="eyebrow">Community</span>
      <h2>Come hang in our <span class="gradient-text">Discord</span>.</h2>
      <p>
        Get product updates, share what your AI partner is up to, swap setups,
        and shape what we build next. We read everything.
      </p>

      <div class="cta-row">
        <a
          href={DISCORD_URL}
          target="_blank"
          rel="noopener"
          class="btn btn-primary discord-btn"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor">
            <path d="M20.317 4.369A19.79 19.79 0 0 0 16.558 3.2a.075.075 0 0 0-.079.037c-.34.6-.717 1.385-.98 2.003a18.27 18.27 0 0 0-5.487 0 12.48 12.48 0 0 0-.995-2.003.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 5.179 4.369a.07.07 0 0 0-.032.027C2.504 8.045 1.78 11.625 2.137 15.16a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.873-1.295 1.226-1.994a.076.076 0 0 0-.041-.105 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.372-.291a.074.074 0 0 1 .077-.01c3.927 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.009c.12.099.246.198.373.292a.077.077 0 0 1-.006.128 12.299 12.299 0 0 1-1.873.891.077.077 0 0 0-.04.106c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.84 19.84 0 0 0 6.002-3.03.077.077 0 0 0 .031-.056c.5-4.087-.838-7.638-3.548-10.764a.061.061 0 0 0-.031-.028zM8.02 13.005c-1.182 0-2.156-1.085-2.156-2.418 0-1.334.955-2.419 2.156-2.419 1.21 0 2.175 1.094 2.156 2.419 0 1.333-.955 2.418-2.156 2.418zm7.974 0c-1.181 0-2.156-1.085-2.156-2.418 0-1.334.955-2.419 2.156-2.419 1.21 0 2.176 1.094 2.156 2.419 0 1.333-.946 2.418-2.156 2.418z"/>
          </svg>
          Join the Discord
        </a>
      </div>

      <p class="waitlist__alt">
        Prefer to self-host? <a href="https://github.com/ericwang915/ClawSoul" target="_blank" rel="noopener">Run it locally on GitHub →</a>
      </p>
    </div>
  </div>
</section>

<style>
  .waitlist__card {
    position: relative;
    overflow: hidden;
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
    padding: 64px 40px;
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    backdrop-filter: blur(12px);
  }
  .waitlist__card .eyebrow { margin-bottom: 20px; }
  .waitlist__card h2 { margin-bottom: 16px; }
  .waitlist__card > p {
    max-width: 480px;
    margin: 0 auto 32px;
    color: var(--text-soft);
  }
  .waitlist__glow {
    position: absolute;
    width: 600px;
    height: 600px;
    top: -300px;
    left: 50%;
    transform: translateX(-50%);
    background: radial-gradient(circle, rgba(88, 101, 242, 0.22), transparent 60%);
    pointer-events: none;
  }
  .cta-row {
    display: flex;
    justify-content: center;
  }
  .discord-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #5865F2;
    border-color: #5865F2;
    color: white;
    padding: 14px 28px;
  }
  .discord-btn:hover {
    background: #4752c4;
    border-color: #4752c4;
  }
  .waitlist__alt {
    margin: 24px 0 0;
    font-size: 0.88rem;
    color: var(--text-muted);
  }
  .waitlist__alt a {
    color: var(--accent);
    font-weight: 600;
  }
  @media (max-width: 720px) {
    .waitlist__card { padding: 48px 24px; }
  }
</style>
