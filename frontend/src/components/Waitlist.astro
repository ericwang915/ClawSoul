---
---
<section id="waitlist" class="waitlist">
  <div class="container">
    <div class="waitlist__card">
      <div class="waitlist__glow" aria-hidden="true"></div>
      <span class="eyebrow">Early access</span>
      <h2>Be the first to <span class="gradient-text">meet them</span>.</h2>
      <p>
        Hosted version is coming soon. Drop your email and we'll send you an invite
        the day it goes live — no spam, no sharing, ever.
      </p>

      <form class="form" id="waitlist-form" novalidate>
        <label class="sr-only" for="email">Email</label>
        <input
          id="email"
          name="email"
          type="email"
          placeholder="you@example.com"
          required
          autocomplete="email"
        />
        <button type="submit" class="btn btn-primary">Get my invite</button>
      </form>

      <p class="form__status" id="form-status" role="status" aria-live="polite"></p>

      <p class="waitlist__alt">
        Prefer to self-host? <a href="https://github.com/ericwang915/ClawSoul" target="_blank" rel="noopener">Run it locally on GitHub →</a>
      </p>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const form = document.getElementById('waitlist-form');
    const status = document.getElementById('form-status');
    if (!form || !status) return;

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const email = (data.get('email') || '').toString().trim();

      if (!email || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
        status.textContent = 'Please enter a valid email.';
        status.style.color = '#fca5a5';
        return;
      }

      try {
        const list = JSON.parse(localStorage.getItem('clawsoul_waitlist') || '[]');
        if (!list.includes(email)) list.push(email);
        localStorage.setItem('clawsoul_waitlist', JSON.stringify(list));
      } catch (_) { /* ignore */ }

      status.textContent = "You're on the list. We'll be in touch ❤";
      status.style.color = '#86efac';
      form.reset();
    });
  })();
</script>

<style>
  .waitlist__card {
    position: relative;
    overflow: hidden;
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
    padding: 64px 40px;
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    backdrop-filter: blur(12px);
  }
  .waitlist__card .eyebrow { margin-bottom: 20px; }
  .waitlist__card h2 { margin-bottom: 16px; }
  .waitlist__card > p {
    max-width: 480px;
    margin: 0 auto 32px;
    color: var(--text-soft);
  }
  .waitlist__glow {
    position: absolute;
    width: 600px;
    height: 600px;
    top: -300px;
    left: 50%;
    transform: translateX(-50%);
    background: radial-gradient(circle, rgba(192, 132, 252, 0.18), transparent 60%);
    pointer-events: none;
  }
  .form {
    position: relative;
    display: flex;
    gap: 10px;
    max-width: 460px;
    margin: 0 auto;
    flex-wrap: wrap;
  }
  .form input {
    flex: 1;
    min-width: 220px;
    padding: 14px 20px;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid var(--border-strong);
    border-radius: 100px;
    color: var(--text);
    font-size: 0.95rem;
    font-family: inherit;
    outline: none;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .form input:focus {
    border-color: var(--accent);
    background: rgba(0, 0, 0, 0.4);
  }
  .form input::placeholder { color: var(--text-muted); }
  .form__status {
    margin: 16px 0 0;
    font-size: 0.9rem;
    min-height: 1.4em;
    color: var(--text-soft);
  }
  .waitlist__alt {
    margin: 24px 0 0;
    font-size: 0.88rem;
    color: var(--text-muted);
  }
  .waitlist__alt a {
    color: var(--accent);
    font-weight: 600;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }
  @media (max-width: 720px) {
    .waitlist__card { padding: 48px 24px; }
  }
</style>
