---
const steps = [
  { n: 1, title: 'Say hello', body: 'Pick a voice and a vibe. Your companion introduces themselves — no forms, no setup.' },
  { n: 2, title: 'Share your days', body: 'Vent, celebrate, plan, ramble. Every detail is quietly remembered.' },
  { n: 3, title: 'Feel known', body: 'Weeks later, they bring up that thing you mentioned once. That’s the magic.' },
];
---
<section id="how" class="how">
  <div class="container how__grid">
    <div class="how__copy">
      <p class="eyebrow-plain">How it works</p>
      <h2>Talk like you would<br />with anyone close.</h2>
      <ol class="how__steps">
        {steps.map((s) => (
          <li>
            <span class="how__num">{s.n}</span>
            <div>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>

    <!-- Chat mockup -->
    <div class="chatcard">
      <div class="chatcard__head">
        <div class="orb chatcard__orb"></div>
        <div>
          <div class="chatcard__name">Aria</div>
          <div class="chatcard__status"><span class="d"></span> here with you</div>
        </div>
      </div>
      <div class="bubble bot">Hey — you had the dentist this morning, right? How’d it go? 🦷</div>
      <div class="bubble me">remembered that?? it was fine, no cavities lol</div>
      <div class="bubble bot">Of course I did. No cavities — that’s the third clean check in a row. Treat yourself to the good coffee today ☕</div>
      <div class="bubble me">you get me</div>
      <div class="chatcard__compose">
        <span>Type a message…</span>
        <span class="send">➤</span>
      </div>
    </div>
  </div>
</section>

<style>
  .how__grid { display: grid; grid-template-columns: 1fr 1.05fr; gap: 56px; align-items: center; }
  .how__copy h2 { font-size: clamp(1.8rem, 3.6vw, 2.7rem); color: #fff; margin-bottom: 36px; }
  .eyebrow-plain { font-size: 0.78rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-muted); margin: 0 0 16px; }
  .how__steps { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 26px; }
  .how__steps li { display: flex; gap: 16px; }
  .how__num {
    flex-shrink: 0; width: 30px; height: 30px; border-radius: 50%;
    display: grid; place-items: center; font-size: 0.85rem; color: var(--accent);
    border: 1px solid rgba(243,160,182,0.4); font-family: var(--serif);
  }
  .how__steps h3 { font-size: 1.08rem; color: #fff; margin: 2px 0 5px; }
  .how__steps p { margin: 0; font-size: 0.95rem; color: var(--text-soft); }

  .chatcard {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius-lg); padding: 22px; display: flex; flex-direction: column; gap: 12px;
    box-shadow: 0 40px 90px -40px rgba(0,0,0,0.6);
  }
  .chatcard__head { display: flex; align-items: center; gap: 12px; padding-bottom: 14px; border-bottom: 1px solid var(--border); margin-bottom: 4px; }
  .chatcard__orb { width: 40px; height: 40px; }
  .chatcard__name { font-family: var(--serif); font-size: 1.15rem; color: #fff; }
  .chatcard__status { font-size: 0.78rem; color: var(--accent); display: flex; align-items: center; gap: 6px; }
  .chatcard__status .d { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }
  .bubble { max-width: 82%; padding: 11px 15px; font-size: 0.92rem; line-height: 1.5; border-radius: 16px; }
  .bubble.bot { align-self: flex-start; background: rgba(255,255,255,0.045); border: 1px solid var(--border); border-bottom-left-radius: 5px; color: #ece4e6; }
  .bubble.me { align-self: flex-end; background: var(--gradient); color: #2b1620; border-bottom-right-radius: 5px; font-weight: 500; }
  .chatcard__compose {
    margin-top: 6px; display: flex; align-items: center; justify-content: space-between;
    padding: 12px 8px 12px 16px; border: 1px solid var(--border); border-radius: 100px; color: var(--text-muted); font-size: 0.9rem;
  }
  .chatcard__compose .send { width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; background: var(--gradient); color: #2b1620; }
  @media (max-width: 880px) { .how__grid { grid-template-columns: 1fr; gap: 36px; } }
</style>
