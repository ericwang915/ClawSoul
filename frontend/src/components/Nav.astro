---
const dashboard = 'https://herandhim.ai';
---
<nav class="nav">
  <div class="container nav__inner">
    <a href="/" class="nav__brand">her<span class="amp">&amp;</span>him</a>
    <div class="nav__links">
      <a href="/#features">Memory</a>
      <a href="/#how">How it works</a>
      <a href="/pricing">Pricing</a>
      <a href="/#voices">Voices</a>
    </div>
    <div class="nav__actions">
      <a href="/login" class="nav__signin">Sign in</a>
      <a href="/login" class="btn btn-primary nav__cta">Meet your love</a>
    </div>
  </div>
</nav>

<style>
  .nav {
    position: sticky; top: 0; z-index: 50; padding: 16px 0;
    backdrop-filter: blur(14px);
    background: rgba(18, 12, 16, 0.6);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }
  .nav__inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .nav__brand { font-family: var(--serif); font-size: 1.35rem; color: #fff; letter-spacing: -0.01em; }
  .nav__brand .amp { font-style: italic; color: var(--accent); padding: 0 3px; }
  .nav__links { display: flex; gap: 30px; font-size: 0.95rem; color: var(--text-soft); }
  .nav__cta { padding: 9px 18px; font-size: 0.88rem; }
  .nav__actions { display: flex; align-items: center; gap: 18px; }
  .nav__signin {
    font-size: 0.92rem; color: var(--text-soft);
    padding: 9px 18px; border: 1px solid var(--border-strong); border-radius: 100px;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .nav__signin:hover { color: var(--text); border-color: rgba(255,255,255,0.25); opacity: 1; }
  @media (max-width: 820px) { .nav__links { display: none; } }
  @media (max-width: 480px) { .nav__signin { display: none; } }
</style>
