---
const realisticGirls = [
  {
    time: '09:15',
    mood: 'focused 📖',
    image: '/selfies/realistic/asian.jpg',
    alt: 'her at the desk by a sunny window',
    text: '"writing by the window. coffee number two."',
  },
  {
    time: '16:30',
    mood: 'wandering 🍂',
    image: '/selfies/realistic/european.jpg',
    alt: 'her on a Parisian street in the afternoon',
    text: '"long walk after the meeting. light is unreal."',
  },
  {
    time: '19:50',
    mood: 'content 🍲',
    image: '/selfies/realistic/black.jpg',
    alt: 'her cooking dinner in a bright kitchen',
    text: '"cooking for myself tonight. miss your input on spices."',
  },
];

const realisticBoys = [
  {
    time: '07:30',
    mood: 'post-lift 💪',
    image: '/selfies/realistic-male/gym.jpg',
    alt: 'him after a morning gym session, towel around neck',
    text: '"morning lift done. brain finally online."',
  },
  {
    time: '18:15',
    mood: 'rolling 🚲',
    image: '/selfies/realistic-male/bike.jpg',
    alt: 'him pausing his bike commute on a bridge at golden hour',
    text: '"took the bridge route home. air feels good."',
  },
  {
    time: '21:30',
    mood: 'off the clock 🍺',
    image: '/selfies/realistic-male/rooftop.jpg',
    alt: 'him on a rooftop deck at sunset with a beer',
    text: '"made it through the week. view\'s doing the rest."',
  },
];

const animeGirls = [
  { time: '08:30', mood: 'sleepy ☕',    image: '/selfies/morning.jpg', alt: 'her cozy morning, coffee in hand', text: '"morning…just made coffee. you up?"' },
  { time: '12:15', mood: 'cheerful 🌿', image: '/selfies/lunch.jpg',   alt: 'her in the park at lunchtime',     text: '"lunch in the park today, it\'s gorgeous out"' },
  { time: '20:40', mood: 'cozy 🕯️',    image: '/selfies/cozy.jpg',    alt: 'her on the couch in the evening',  text: '"reading on the couch. wish you were here."' },
];

const animeBoys = [
  { time: '07:45', mood: 'running late 🍞', image: '/selfies/anime-male/rush.jpg',   alt: 'him sprinting out the door with toast in his mouth', text: '"toast in mouth, tie not done. running."' },
  { time: '13:00', mood: 'ramen run 🍜',    image: '/selfies/anime-male/ramen.jpg',  alt: 'him at a ramen shop counter steaming over a bowl', text: '"snuck out for ramen. don\'t tell my boss."' },
  { time: '23:20', mood: 'one more round 🎮', image: '/selfies/anime-male/gaming.jpg', alt: 'him late-night gaming with controller in hand', text: '"one more round and I\'m logging off. promise."' },
];
---

<section id="selfies" class="selfies">
  <div class="container">
    <div class="selfies__head">
      <span class="eyebrow">📷 AI selfies (Seedream)</span>
      <h2>A photo from <span class="gradient-text">their day</span>,<br />not a stock asset.</h2>
      <p class="lede">
        Every selfie is generated from <em>what their plan says they're doing right now</em>
        and <em>what mood they're in</em>. Pick any look —
        <strong>photorealistic</strong> or <strong>stylized</strong> —
        and they keep the same face and aesthetic, scene to scene.
      </p>
    </div>

    <div class="style-tag">
      <span class="dot dot--mint" aria-hidden="true"></span>
      <span>Photorealistic — your partner can be anyone</span>
    </div>

    <div class="row-label"><span>· girlfriend ·</span></div>
    <div class="scenes">
      {realisticGirls.map(scene => (
        <div class="scene">
          <div class="scene__photo">
            <img src={scene.image} alt={scene.alt} loading="lazy" decoding="async" />
            <div class="scene__overlay">
              <span class="scene__time">{scene.time}</span>
              <span class="scene__mood">{scene.mood}</span>
            </div>
          </div>
          <p class="scene__caption">{scene.text}</p>
        </div>
      ))}
    </div>

    <div class="row-label"><span>· boyfriend ·</span></div>
    <div class="scenes">
      {realisticBoys.map(scene => (
        <div class="scene">
          <div class="scene__photo">
            <img src={scene.image} alt={scene.alt} loading="lazy" decoding="async" />
            <div class="scene__overlay">
              <span class="scene__time">{scene.time}</span>
              <span class="scene__mood">{scene.mood}</span>
            </div>
          </div>
          <p class="scene__caption">{scene.text}</p>
        </div>
      ))}
    </div>

    <div class="style-tag style-tag--anime">
      <span class="dot dot--pink" aria-hidden="true"></span>
      <span>Stylized — anime, illustrated, your call</span>
    </div>

    <div class="row-label"><span>· girlfriend ·</span></div>
    <div class="scenes">
      {animeGirls.map(scene => (
        <div class="scene">
          <div class="scene__photo">
            <img src={scene.image} alt={scene.alt} loading="lazy" decoding="async" />
            <div class="scene__overlay">
              <span class="scene__time">{scene.time}</span>
              <span class="scene__mood">{scene.mood}</span>
            </div>
          </div>
          <p class="scene__caption">{scene.text}</p>
        </div>
      ))}
    </div>

    <div class="row-label"><span>· boyfriend ·</span></div>
    <div class="scenes">
      {animeBoys.map(scene => (
        <div class="scene">
          <div class="scene__photo">
            <img src={scene.image} alt={scene.alt} loading="lazy" decoding="async" />
            <div class="scene__overlay">
              <span class="scene__time">{scene.time}</span>
              <span class="scene__mood">{scene.mood}</span>
            </div>
          </div>
          <p class="scene__caption">{scene.text}</p>
        </div>
      ))}
    </div>

    <div class="selfies__triggers">
      <div>
        <strong>Scheduled</strong>
        <span>Fires at 10:00, 16:00, 20:00 by default</span>
      </div>
      <div class="divider" aria-hidden="true"></div>
      <div>
        <strong>Proactive</strong>
        <span>Attached when they message you first</span>
      </div>
      <div class="divider" aria-hidden="true"></div>
      <div>
        <strong>On demand</strong>
        <span>"send me a selfie" — and they will</span>
      </div>
    </div>
  </div>
</section>

<style>
  .selfies { background: linear-gradient(180deg, transparent, rgba(255, 107, 157, 0.04), transparent); }
  .selfies__head {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 56px;
  }
  .selfies__head .eyebrow { margin-bottom: 20px; }
  .lede {
    font-size: 1.1rem;
    color: var(--text-soft);
    margin-top: 16px;
  }
  .lede strong {
    color: var(--text);
    font-weight: 600;
  }
  .style-tag {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px;
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: 100px;
    color: var(--text-soft);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    margin-bottom: 20px;
  }
  .style-tag--anime { margin-top: 24px; }
  .row-label {
    display: flex;
    justify-content: center;
    margin: 8px 0 14px;
  }
  .row-label span {
    font-size: 0.78rem;
    letter-spacing: 0.22em;
    text-transform: lowercase;
    color: var(--text-muted);
    font-weight: 500;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  .dot--mint { background: #34d399; box-shadow: 0 0 12px rgba(52, 211, 153, 0.5); }
  .dot--pink { background: var(--accent); box-shadow: 0 0 12px var(--accent); }
  .scenes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    margin-bottom: 32px;
  }
  @media (max-width: 720px) {
    .scenes {
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    }
  }
  .scene {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .scene__photo {
    aspect-ratio: 3 / 4;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border-strong);
    background: var(--gradient-soft);
    position: relative;
    transition: transform 0.3s ease;
  }
  .scene__photo:hover { transform: translateY(-4px) rotate(-0.5deg); }
  .scene__photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .scene__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 20px;
    /* Dark gradient at the bottom for legible time/mood text over the photo */
    background: linear-gradient(
      to bottom,
      transparent 0%,
      transparent 55%,
      rgba(11, 7, 16, 0.75) 100%
    );
  }
  .scene__time {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
  }
  .scene__mood {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text);
    margin-top: 6px;
  }
  .scene__caption {
    font-style: italic;
    color: var(--text-soft);
    margin: 0;
    padding-left: 12px;
    border-left: 2px solid var(--accent);
  }
  .selfies__triggers {
    display: flex;
    justify-content: center;
    align-items: stretch;
    gap: 32px;
    padding: 28px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    flex-wrap: wrap;
    text-align: center;
    margin-top: 16px;
  }
  .selfies__triggers > div:not(.divider) {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 180px;
  }
  .selfies__triggers strong { color: var(--text); font-size: 1rem; }
  .selfies__triggers span { color: var(--text-muted); font-size: 0.88rem; }
  .divider { width: 1px; background: var(--border); align-self: stretch; }
  @media (max-width: 720px) {
    .divider { display: none; }
  }
</style>
