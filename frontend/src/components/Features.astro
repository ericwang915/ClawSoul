---
const features = [
  {
    icon: '✦',
    title: 'Remembers the details',
    body: 'Names, dates, inside jokes, the things that stress you out. They keep it all — so you never re-explain your life.',
  },
  {
    icon: '♥',
    title: 'Grows with you',
    body: 'Every conversation deepens the bond. The more you share, the more you feel understood.',
  },
  {
    icon: '☐',
    title: 'Shows up daily',
    body: 'A morning check-in, a note before your big meeting, a "how did it go?" after. Presence, not pings.',
  },
];
---
<section id="features" class="features">
  <div class="container">
    <p class="eyebrow-plain">The Difference</p>
    <h2 class="features__head">
      Most chatbots forget you by the next message. <span class="it grad">Ours doesn't.</span>
    </h2>

    <div class="features__grid">
      {features.map((f) => (
        <div class="fcard">
          <div class="fcard__icon">{f.icon}</div>
          <h3>{f.title}</h3>
          <p>{f.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .eyebrow-plain {
    font-size: 0.78rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--text-muted); margin: 0 0 16px;
  }
  .features__head { font-size: clamp(1.9rem, 4vw, 3rem); max-width: 760px; color: #fff; margin-bottom: 56px; }
  .features__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .fcard {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 28px 26px 30px;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .fcard:hover { border-color: rgba(243,160,182,0.3); transform: translateY(-3px); }
  .fcard__icon {
    width: 42px; height: 42px; border-radius: 12px; display: grid; place-items: center;
    font-size: 1.1rem; color: var(--accent);
    background: rgba(243,160,182,0.12); border: 1px solid rgba(243,160,182,0.2);
    margin-bottom: 22px;
  }
  .fcard h3 { font-size: 1.2rem; color: #fff; margin-bottom: 10px; }
  .fcard p { color: var(--text-soft); margin: 0; font-size: 0.96rem; }
  @media (max-width: 820px) { .features__grid { grid-template-columns: 1fr; } }
</style>
