---
---
<section class="hero">
  <div class="container hero__grid">
    <!-- Left: copy -->
    <div class="hero__copy">
      <span class="eyebrow"><span class="dot"></span> An AI companion with a long memory</span>
      <h1>
        The AI companion who <span class="it grad">actually</span> remembers you<br />and takes selfies.
      </h1>
      <p class="hero__sub">
        She or he is a companion that holds your story — the small jokes, the hard weeks,
        the people you love — and grows closer the more you talk.
      </p>
      <div class="hero__cta">
        <a href="/login" class="btn btn-primary">Meet your love →</a>
        <a href="/#how" class="btn btn-secondary">How it works</a>
      </div>
      <div class="hero__assure">
        <span>🔒 Private by design</span>
        <span>♥ Free to start</span>
      </div>
    </div>

    <!-- Right: orb + floating memory chips -->
    <div class="hero__stage">
      <div class="orb hero__orb"></div>
      <span class="chip chip--a">🎂 Anniversary — Aug 14</span>
      <span class="chip chip--b">Hates Monday mornings</span>
      <span class="chip chip--c">Sister's name is Lena</span>
      <span class="chip chip--d">Dreams of seeing Lisbon</span>
    </div>
  </div>
</section>

<style>
  .hero { padding: 70px 0 90px; overflow: hidden; }
  .hero__grid {
    display: grid; grid-template-columns: 1.05fr 1fr; gap: 48px; align-items: center;
  }
  .hero__copy h1 { font-size: clamp(2.3rem, 4.8vw, 3.7rem); margin: 22px 0 0; color: #fff; }
  .grad {
    background: var(--gradient); -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .hero__sub { max-width: 460px; margin: 26px 0 34px; font-size: 1.1rem; color: var(--text-soft); }
  .hero__cta { display: flex; gap: 14px; flex-wrap: wrap; }
  .hero__assure { display: flex; gap: 26px; margin-top: 28px; font-size: 0.9rem; color: var(--text-muted); }

  .hero__stage { position: relative; height: 460px; display: flex; align-items: center; justify-content: center; }
  .hero__orb {
    width: 320px; height: 320px;
    animation: float 7s ease-in-out infinite;
  }
  @keyframes float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-14px); } }
  .chip {
    position: absolute; padding: 9px 15px; font-size: 0.86rem; color: var(--text);
    background: rgba(30, 20, 26, 0.82); border: 1px solid var(--border-strong);
    border-radius: 100px; backdrop-filter: blur(8px); white-space: nowrap;
    box-shadow: 0 8px 30px -10px rgba(0,0,0,0.5);
  }
  .chip--a { top: 6%; left: 50%; transform: translateX(-58%); }
  .chip--b { top: 32%; right: -2%; }
  .chip--c { bottom: 26%; left: -4%; }
  .chip--d { bottom: 6%; right: 8%; }
  .dot {
    width: 7px; height: 7px; background: var(--accent); border-radius: 50%;
    box-shadow: 0 0 12px var(--accent); animation: pulse 2.4s ease-in-out infinite;
  }
  @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.5; } }

  @media (max-width: 880px) {
    .hero__grid { grid-template-columns: 1fr; gap: 12px; }
    .hero__stage { height: 360px; order: -1; }
    .hero__orb { width: 240px; height: 240px; }
    .hero__copy h1 { margin-top: 10px; }
  }
</style>
