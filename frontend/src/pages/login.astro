---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';

const DASHBOARD = 'https://clawsoul.fly.dev';
---

<Layout title="Sign in · ClawSoul" description="Sign in to your ClawSoul dashboard.">
  <Nav />
  <main>
    <section class="login">
      <div class="card">
        <span class="eyebrow">Dashboard sign in</span>
        <h1>Welcome <span class="gradient-text">back</span>.</h1>
        <p class="sub">Use the email you registered in Supabase to access your ClawSoul dashboard.</p>

        <div class="providers">
          <button type="button" class="provider" data-provider="google">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path fill="#EA4335" d="M12 5.04c1.62 0 3.07.56 4.22 1.65l3.15-3.15C17.45 1.7 14.97.6 12 .6 7.39.6 3.4 3.24 1.46 7.08l3.66 2.84C6.06 7.13 8.77 5.04 12 5.04z"/>
              <path fill="#4285F4" d="M23.5 12.27c0-.79-.07-1.55-.21-2.27H12v4.3h6.45c-.28 1.5-1.12 2.77-2.39 3.62l3.66 2.84c2.13-1.97 3.78-5.16 3.78-8.49z"/>
              <path fill="#FBBC05" d="M5.12 14.32a7.13 7.13 0 0 1-.37-2.32c0-.81.13-1.6.37-2.32L1.46 6.84A11.39 11.39 0 0 0 .6 12c0 1.84.44 3.58 1.22 5.12l3.66-2.84z"/>
              <path fill="#34A853" d="M12 23.4c3.24 0 5.95-1.07 7.93-2.91l-3.66-2.84c-1.02.69-2.33 1.1-4.27 1.1-3.23 0-5.94-2.09-6.92-4.91l-3.66 2.84A11.45 11.45 0 0 0 12 23.4z"/>
            </svg>
            Continue with Google
          </button>
          <button type="button" class="provider" data-provider="github">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path fill="currentColor" d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.79 8.21 11.39.6.11.82-.26.82-.58v-2.04c-3.34.73-4.04-1.42-4.04-1.42-.55-1.4-1.34-1.77-1.34-1.77-1.1-.75.08-.73.08-.73 1.21.09 1.85 1.24 1.85 1.24 1.08 1.84 2.83 1.31 3.52 1 .11-.78.42-1.31.77-1.61-2.67-.31-5.47-1.33-5.47-5.94 0-1.31.47-2.38 1.24-3.22-.13-.31-.54-1.55.12-3.23 0 0 1.01-.32 3.3 1.23a11.45 11.45 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.68.25 2.92.12 3.23.77.84 1.24 1.91 1.24 3.22 0 4.62-2.81 5.63-5.49 5.93.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58A12.01 12.01 0 0 0 24 12.5C24 5.87 18.63.5 12 .5z"/>
            </svg>
            Continue with GitHub
          </button>
        </div>

        <div class="divider"><span>or use email</span></div>

        <form id="login-form" autocomplete="on">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" required autocomplete="email" />

          <label for="password">Password</label>
          <input id="password" name="password" type="password" required autocomplete="current-password" />

          <button type="submit" id="submit-btn" class="btn-submit">Sign in</button>
        </form>

        <p id="status" class="status" role="status" aria-live="polite"></p>

        <p class="toggle">
          No account yet? <a id="signup-toggle">Create one</a>
        </p>

        <p class="meta">
          Lost? <a href="/">Back to home</a> · Powered by Supabase
        </p>
      </div>
    </section>
  </main>

  <script is:inline define:vars={{ DASHBOARD }}>
    (async () => {
      const statusEl = document.getElementById('status');
      const btn = document.getElementById('submit-btn');
      const setStatus = (msg, kind = '') => {
        statusEl.textContent = msg;
        statusEl.className = 'status ' + kind;
      };

      // Lazy-load Supabase JS SDK from CDN
      const { createClient } = await import('https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/+esm');

      // Pull Supabase config from the dashboard backend (single source of truth)
      let cfg;
      try {
        const r = await fetch(`${DASHBOARD}/api/auth/config`, { credentials: 'omit' });
        if (!r.ok) throw new Error('config fetch failed');
        cfg = await r.json();
      } catch (e) {
        setStatus('Cannot reach the dashboard backend. Try again later.', 'error');
        return;
      }
      if (!cfg.enabled || !cfg.url || !cfg.anonKey) {
        setStatus('Authentication is not configured on the server.', 'error');
        return;
      }

      const sb = createClient(cfg.url, cfg.anonKey);

      // OAuth buttons — Supabase redirects to provider, then back to /auth/callback
      document.querySelectorAll('.provider').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const provider = btn.getAttribute('data-provider');
          setStatus('Redirecting to ' + provider + '…', 'ok');
          const { error } = await sb.auth.signInWithOAuth({
            provider,
            options: {
              redirectTo: window.location.origin + '/auth/callback',
            },
          });
          if (error) setStatus(error.message, 'error');
        });
      });

      let mode = 'signin';
      const toggle = document.getElementById('signup-toggle');
      const toggleP = document.querySelector('.toggle');
      toggle.addEventListener('click', () => {
        mode = mode === 'signin' ? 'signup' : 'signin';
        btn.textContent = mode === 'signin' ? 'Sign in' : 'Create account';
        toggleP.firstChild.textContent = mode === 'signin' ? 'No account yet? ' : '';
        toggle.textContent = mode === 'signin' ? 'Create one' : 'Have an account? Sign in';
        setStatus('');
      });

      document.getElementById('login-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        btn.disabled = true;
        setStatus('');

        const email = document.getElementById('email').value.trim();
        const password = document.getElementById('password').value;

        const { data, error } = mode === 'signin'
          ? await sb.auth.signInWithPassword({ email, password })
          : await sb.auth.signUp({ email, password });

        if (error) {
          setStatus(error.message, 'error');
          btn.disabled = false;
          return;
        }

        if (!data.session) {
          setStatus('Check your email to confirm your account.', 'ok');
          btn.disabled = false;
          return;
        }

        // Cross-origin POST: the cookie lands on clawsoul.fly.dev where the dashboard reads it.
        const r = await fetch(`${DASHBOARD}/api/auth/session`, {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ access_token: data.session.access_token }),
        });

        if (!r.ok) {
          const body = await r.json().catch(() => ({}));
          setStatus(body.error || `Auth failed (HTTP ${r.status})`, 'error');
          btn.disabled = false;
          return;
        }

        setStatus('Signed in. Redirecting…', 'ok');
        // Top-level navigation: cookie set above will be sent on this request.
        window.location.href = `${DASHBOARD}/`;
      });
    })();
  </script>
</Layout>

<style>
  .login {
    min-height: calc(100vh - 200px);
    display: grid;
    place-items: center;
    padding: 60px 24px;
  }
  .card {
    width: min(92vw, 460px);
    padding: 48px 36px;
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    backdrop-filter: blur(12px);
    text-align: center;
  }
  .card .eyebrow { margin-bottom: 18px; }
  .card h1 {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    margin: 0 0 12px;
  }
  .sub {
    color: var(--text-soft);
    margin: 0 0 28px;
    font-size: 0.95rem;
  }
  form {
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-align: left;
  }
  label {
    font-size: 0.8rem;
    color: var(--text-soft);
    margin-top: 8px;
    letter-spacing: 0.04em;
  }
  input {
    padding: 12px 16px;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid var(--border-strong);
    border-radius: 12px;
    color: var(--text);
    font-size: 0.95rem;
    font-family: inherit;
    outline: none;
    transition: border-color 0.15s ease;
  }
  input:focus { border-color: var(--accent); }
  .btn-submit {
    margin-top: 18px;
    padding: 14px 16px;
    background: var(--gradient);
    color: #fff;
    border: none;
    border-radius: 100px;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    font-family: inherit;
    box-shadow: var(--shadow-glow);
    transition: transform 0.18s ease;
  }
  .btn-submit:hover:not(:disabled) { transform: translateY(-2px); }
  .btn-submit:disabled { opacity: 0.5; cursor: not-allowed; }

  .providers {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 22px;
  }
  .provider {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 12px 16px;
    background: var(--surface-strong);
    color: var(--text);
    border: 1px solid var(--border-strong);
    border-radius: 12px;
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
  }
  .provider:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.25);
    transform: translateY(-1px);
  }
  .provider svg { flex-shrink: 0; }

  .divider {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 6px 0 14px;
    color: var(--text-muted);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .divider::before,
  .divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
  }
  .status {
    margin-top: 16px;
    min-height: 1.3em;
    font-size: 0.88rem;
  }
  .status.error { color: #fca5a5; }
  .status.ok    { color: #86efac; }
  .toggle {
    margin: 24px 0 0;
    font-size: 0.88rem;
    color: var(--text-soft);
  }
  .toggle a { color: var(--accent); cursor: pointer; font-weight: 600; }
  .meta {
    margin: 8px 0 0;
    font-size: 0.78rem;
    color: var(--text-muted);
  }
  .meta a { color: var(--text-soft); }
</style>
