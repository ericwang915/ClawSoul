---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';

const DASHBOARD = 'https://app.herandhim.ai';
---

<Layout title="Signing in… · her & him" description="Completing sign-in.">
  <Nav />
  <main>
    <section class="callback">
      <div class="card">
        <div class="spinner" id="spinner"></div>
        <h1 id="title">Signing you in…</h1>
        <p id="message" class="message">Hang tight while we finish authenticating.</p>
        <a href="/login" id="retry" class="retry" hidden>Back to sign in →</a>
      </div>
    </section>
  </main>

  <script is:inline define:vars={{ DASHBOARD }}>
    (async () => {
      const titleEl = document.getElementById('title');
      const msgEl = document.getElementById('message');
      const spinner = document.getElementById('spinner');
      const retry = document.getElementById('retry');

      const fail = (msg) => {
        spinner.style.display = 'none';
        titleEl.textContent = 'Sign-in failed';
        msgEl.textContent = msg;
        msgEl.classList.add('error');
        retry.hidden = false;
      };

      const ok = (msg) => {
        titleEl.textContent = 'Welcome!';
        msgEl.textContent = msg;
        msgEl.classList.add('ok');
      };

      const { createClient } = await import('https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/+esm');

      let cfg;
      try {
        const r = await fetch(`${DASHBOARD}/api/auth/config`, { credentials: 'omit' });
        cfg = await r.json();
      } catch (e) {
        return fail('Cannot reach the dashboard backend.');
      }
      if (!cfg.enabled || !cfg.url || !cfg.anonKey) {
        return fail('Authentication is not configured on the server.');
      }

      // Surface OAuth errors that Supabase puts in the URL
      const hashParams = new URLSearchParams(window.location.hash.slice(1));
      const queryParams = new URLSearchParams(window.location.search);
      const oauthError = hashParams.get('error_description') || queryParams.get('error_description');
      if (oauthError) return fail(oauthError);

      const sb = createClient(cfg.url, cfg.anonKey, {
        auth: { detectSessionInUrl: true, persistSession: true },
      });

      // Wait a tick for the SDK to consume the URL hash and stash the session
      const { data: { session }, error } = await sb.auth.getSession();
      if (error) return fail(error.message);
      if (!session) return fail('No session returned from OAuth provider.');

      // Hand the JWT to our backend so it can set the HttpOnly cookie
      const r = await fetch(`${DASHBOARD}/api/auth/session`, {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ access_token: session.access_token }),
      });

      if (!r.ok) {
        const body = await r.json().catch(() => ({}));
        const detail = body.error || `Auth failed (HTTP ${r.status})`;
        return fail(`${detail} (email: ${session.user?.email})`);
      }

      ok('Redirecting to your dashboard…');
      window.location.href = `${DASHBOARD}/`;
    })();
  </script>
</Layout>

<style>
  .callback {
    min-height: calc(100vh - 200px);
    display: grid;
    place-items: center;
    padding: 60px 24px;
  }
  .card {
    width: min(92vw, 460px);
    padding: 56px 36px;
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    backdrop-filter: blur(12px);
    text-align: center;
  }
  .card h1 {
    font-size: clamp(1.5rem, 3.6vw, 2rem);
    margin: 12px 0 10px;
  }
  .message {
    margin: 0;
    color: var(--text-soft);
    font-size: 0.95rem;
  }
  .message.error { color: #fca5a5; }
  .message.ok    { color: #86efac; }
  .retry {
    display: inline-block;
    margin-top: 22px;
    font-size: 0.9rem;
    color: var(--accent);
    font-weight: 600;
  }
  .spinner {
    width: 38px;
    height: 38px;
    margin: 0 auto 8px;
    border: 3px solid rgba(255, 255, 255, 0.12);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
</style>
